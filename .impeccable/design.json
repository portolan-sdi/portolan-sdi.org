    "narrative": {
      "_note": "No metaphor. The system is described by its constraints.",
      "constraints": [
        "Light mode only. No [data-theme] switch and no dark token block.",
        "Every radius token is 0px.",
        "Shadow tokens resolve to none or to a single 1px rule.",
        "One accent color, #4163cc. There is no second accent.",
        "Structural rules use #16170f, the same value as body text.",
        "No element uses a gradient."
      ],
      "dos": [
        "Use the named type utilities from the eight-step scale.",
        "Separate content with a 1px #16170f rule.",
        "Start every layout at grid-cols-1 and step up.",
        "Use logical properties in shared UI.",
        "Put every user-facing string in messages/ under the same key in en, es, and ar.",
        "Keep digits Latin in every locale."
      ],
      "donts": [
        "Don't add a dark theme or a theme toggle.",
        "Don't use a gradient anywhere.",
        "Don't round a corner.",
        "Don't add a drop shadow, a glassy blur, or a soft background band.",
        "Don't use an arbitrary font size such as text-[13px].",
        "Don't add a step back to the type scale.",
        "Don't add a border-p-line-strong tier. Thicken the border instead.",
        "Don't inline header or footer markup. Navigation is the rail.",
        "Don't use a compass rose or a rhumb line.",
        "Don't add a terminal or code-session mockup.",
        "Don't add an emoji. The permitted marks are the arrow glyphs and the middle dot.",
        "Don't give every card in a grid the same anatomy.",
        "Don't letterspace Arabic.",
        "Don't mirror the logo, the map canvas, or a code block in RTL."
      ]
    }
